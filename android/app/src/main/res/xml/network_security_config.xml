<?xml version="1.0" encoding="utf-8"?>
<!--
  O app é offline. Se um dia acessar a internet, só por HTTPS e só com
  certificados do sistema (nada de certificados instalados pelo usuário).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
